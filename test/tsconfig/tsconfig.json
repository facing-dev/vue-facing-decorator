{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "strict": true,
        "sourceMap": true,
        "lib": ["esnext", "DOM"],
        "allowJs": true,
        "noUnusedLocals": false,
        "useDefineForClassFields": true,
        "jsx": "preserve",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true
    },
    "ts-node": {
        "transpileOnly": true,
        "files": true,
        "compilerOptions": {
            "module": "CommonJS",
            "moduleResolution": "Node"
        }
    },
    "files": ["../test.ts"]
}
